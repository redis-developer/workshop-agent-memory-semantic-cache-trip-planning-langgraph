# Used by Vercel (it takes this file over a framework it detects) to build the finished app.
# It runs ./solve all --out, so the app it serves has every solution in it. Your own files are not changed.
FROM python:3.15

COPY --from=ghcr.io/astral-sh/uv:0.13.10 /uv /uvx /usr/local/bin/

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock /src/
RUN cd /src && uv sync --locked --no-dev

COPY . /src
RUN python /src/solve all --out /app && rm -rf /src

WORKDIR /app

# Vercel gives the port in PORT. It is 80 when it is not set.
CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-80}"]
