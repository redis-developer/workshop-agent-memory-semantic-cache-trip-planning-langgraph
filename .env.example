# The model that runs the agent
OPENAI_API_KEY="your_openai_api_key"

# Places and weather (Google Maps Platform, with the Maps Experience agent tools API enabled)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Your Redis database
REDIS_URL="your_redis_url"

# Your Redis Agent Memory service (from the Redis Cloud console)
IRIS_AGENT_MEMORY_URL="your_agent_memory_endpoint"
IRIS_AGENT_MEMORY_STORE_ID="your_store_id"
IRIS_AGENT_MEMORY_API_KEY="your_agent_memory_api_key"

# Optional
# MODEL_NAME="gpt-4o-mini"
# PORT=3000
